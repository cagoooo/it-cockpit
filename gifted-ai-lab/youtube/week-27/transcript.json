{
  "duration": 90.163125,
  "segments": [
    {
      "start": 0,
      "end": 0.84,
      "text": "準備好了嗎？"
    },
    {
      "start": 0.84,
      "end": 2.68,
      "text": "今天我們有個超酷任務"
    },
    {
      "start": 2.68,
      "end": 4.48,
      "text": "把你腦中的無敵大點子"
    },
    {
      "start": 4.48,
      "end": 6.16,
      "text": "變成真實作品！"
    },
    {
      "start": 6.16,
      "end": 6.76,
      "text": "想想看"
    },
    {
      "start": 6.76,
      "end": 8.48,
      "text": "如果有一個超讚的點子"
    },
    {
      "start": 8.48,
      "end": 10.12,
      "text": "你會直接花好幾個月"
    },
    {
      "start": 10.12,
      "end": 12.59,
      "text": "一次把整個作品做完嗎？"
    },
    {
      "start": 12.59,
      "end": 14.79,
      "text": "這樣風險太高啦！"
    },
    {
      "start": 14.79,
      "end": 16.67,
      "text": "其實最聰明的做法是"
    },
    {
      "start": 16.67,
      "end": 17.87,
      "text": "只花一天"
    },
    {
      "start": 17.87,
      "end": 21.63,
      "text": "先測試最核心最關鍵的功能"
    },
    {
      "start": 21.63,
      "end": 24.11,
      "text": "這就叫最小可行原型"
    },
    {
      "start": 24.11,
      "end": 25.83,
      "text": "也就是把你超大的點子"
    },
    {
      "start": 25.83,
      "end": 27.31,
      "text": "縮小成最簡單"
    },
    {
      "start": 27.31,
      "end": 29.23,
      "text": "能馬上測試的版本"
    },
    {
      "start": 29.23,
      "end": 30.27,
      "text": "舉例來說"
    },
    {
      "start": 30.27,
      "end": 32.35,
      "text": "別急著做完整的 Scratch 動畫"
    },
    {
      "start": 32.35,
      "end": 33.55,
      "text": "先做個簡單按鈕"
    },
    {
      "start": 33.55,
      "end": 35.71,
      "text": "測試角色會不會動就好"
    },
    {
      "start": 35.71,
      "end": 38.31,
      "text": "秘訣是設計流程"
    },
    {
      "start": 38.31,
      "end": 40.07,
      "text": "只要三個簡單步驟"
    },
    {
      "start": 40.07,
      "end": 41.91,
      "text": "怎麼開始 怎麼操作"
    },
    {
      "start": 41.91,
      "end": 44.47,
      "text": "還有最後會得到什麼結果"
    },
    {
      "start": 44.47,
      "end": 45.39,
      "text": "實作時"
    },
    {
      "start": 45.39,
      "end": 47.63,
      "text": "請記住這個黃金法則"
    },
    {
      "start": 47.63,
      "end": 49.03,
      "text": "大腦先思考"
    },
    {
      "start": 49.03,
      "end": 50.23,
      "text": "AI 來協助"
    },
    {
      "start": 50.23,
      "end": 52.31,
      "text": "最後由你負責判斷"
    },
    {
      "start": 52.31,
      "end": 52.79,
      "text": "沒錯"
    },
    {
      "start": 52.79,
      "end": 54.23,
      "text": "你要先自己想點子"
    },
    {
      "start": 54.23,
      "end": 56.07,
      "text": "再讓 AI 給點建議"
    },
    {
      "start": 56.07,
      "end": 56.91,
      "text": "但記住哦"
    },
    {
      "start": 56.91,
      "end": 57.99,
      "text": "最後做決定的人"
    },
    {
      "start": 57.99,
      "end": 59.27,
      "text": "絕對是你"
    },
    {
      "start": 59.27,
      "end": 61.27,
      "text": "畢竟 AI 只是工具"
    },
    {
      "start": 61.27,
      "end": 63.27,
      "text": "不一定對也沒有標準答案"
    },
    {
      "start": 63.27,
      "end": 64.47,
      "text": "你也得自己當裁判"
    },
    {
      "start": 64.47,
      "end": 66.47,
      "text": "判斷他的建議好不好"
    },
    {
      "start": 66.47,
      "end": 67.71,
      "text": "換你動手了"
    },
    {
      "start": 67.71,
      "end": 68.59,
      "text": "今天任務"
    },
    {
      "start": 68.59,
      "end": 70.19,
      "text": "挑出核心功能"
    },
    {
      "start": 70.19,
      "end": 72.15,
      "text": "畫出三步驟流程"
    },
    {
      "start": 72.15,
      "end": 74.63,
      "text": "接著做出你的測試原型"
    },
    {
      "start": 74.63,
      "end": 76.15,
      "text": "測試後記得記錄下來"
    },
    {
      "start": 76.15,
      "end": 77.23,
      "text": "發現什麼問題"
    },
    {
      "start": 77.23,
      "end": 78.35,
      "text": "下一步怎麼改"
    },
    {
      "start": 78.35,
      "end": 80.67,
      "text": "這就是專業設計師的日常哦"
    },
    {
      "start": 80.67,
      "end": 82.39,
      "text": "現在先暫停討論一下"
    },
    {
      "start": 82.39,
      "end": 84.35,
      "text": "如果只能做一個功能"
    },
    {
      "start": 84.35,
      "end": 85.79,
      "text": "來證明點子有用"
    },
    {
      "start": 85.79,
      "end": 86.75,
      "text": "你會選哪個"
    },
    {
      "start": 86.75,
      "end": 87.25,
      "text": "為什麼"
    }
  ]
}
