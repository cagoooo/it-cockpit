{
  "duration": 102.0516875,
  "segments": [
    {
      "start": 0,
      "end": 1.8,
      "text": "歡迎來到第三十週，"
    },
    {
      "start": 1.8,
      "end": 3.8,
      "text": "準備好為你的超棒作品"
    },
    {
      "start": 3.8,
      "end": 5.8,
      "text": "做最後的衝刺了嗎？"
    },
    {
      "start": 5.8,
      "end": 9,
      "text": "你有沒有過發明瞭超酷的遊戲，"
    },
    {
      "start": 9,
      "end": 11.8,
      "text": "朋友卻完全搞錯怎麼玩的經驗？"
    },
    {
      "start": 11.8,
      "end": 13.6,
      "text": "今天我們就要來大解密，"
    },
    {
      "start": 13.6,
      "end": 16.83,
      "text": "看看你的作品到底好不好用。"
    },
    {
      "start": 16.83,
      "end": 19.43,
      "text": "記住測試的黃金法則，"
    },
    {
      "start": 19.43,
      "end": 21.23,
      "text": "千萬別開口教，"
    },
    {
      "start": 21.23,
      "end": 24.53,
      "text": "安靜觀察它們卡在哪就好。"
    },
    {
      "start": 24.53,
      "end": 26.13,
      "text": "盯緊它們哪裡停頓，"
    },
    {
      "start": 26.13,
      "end": 27.53,
      "text": "誤解或成功，"
    },
    {
      "start": 27.53,
      "end": 30.33,
      "text": "這些真實反應才是進步的關鍵"
    },
    {
      "start": 30.33,
      "end": 32.93,
      "text": "把意見分輕重緩急"
    },
    {
      "start": 32.93,
      "end": 34.13,
      "text": "就像修玩具車，"
    },
    {
      "start": 34.13,
      "end": 35.53,
      "text": "先修好破輪子"
    },
    {
      "start": 35.53,
      "end": 37.33,
      "text": "再去管烤漆顏色。"
    },
    {
      "start": 37.33,
      "end": 38.33,
      "text": "沒錯"
    },
    {
      "start": 38.33,
      "end": 41.53,
      "text": "今天只要挑出最最重要的一兩點"
    },
    {
      "start": 41.53,
      "end": 43.73,
      "text": "優先動手修改就好囉"
    },
    {
      "start": 43.73,
      "end": 45.73,
      "text": "你才是大老闆"
    },
    {
      "start": 45.73,
      "end": 47.53,
      "text": "永遠是你先想點子，"
    },
    {
      "start": 47.53,
      "end": 50.93,
      "text": "AI 只是幫忙擴充的小助手"
    },
    {
      "start": 50.93,
      "end": 54.59,
      "text": "這裡有個絕對要遵守的隱私鐵則："
    },
    {
      "start": 54.59,
      "end": 58.49,
      "text": "千萬別把真名和照片傳給 AI "
    },
    {
      "start": 58.49,
      "end": 61.49,
      "text": "記住喔， AI 只能給建議"
    },
    {
      "start": 61.49,
      "end": 62.69,
      "text": "最後做決定"
    },
    {
      "start": 62.69,
      "end": 64.09,
      "text": "負起全責的"
    },
    {
      "start": 64.09,
      "end": 65.89,
      "text": "永遠是你自己"
    },
    {
      "start": 65.89,
      "end": 67.19,
      "text": "接著"
    },
    {
      "start": 67.19,
      "end": 69.89,
      "text": "來看看今天這 90 分鐘裡"
    },
    {
      "start": 69.89,
      "end": 72.79,
      "text": "我們要挑戰什麼超讚的任務"
    },
    {
      "start": 72.79,
      "end": 74.49,
      "text": "先動手測試"
    },
    {
      "start": 74.49,
      "end": 76.29,
      "text": "排好修改順序"
    },
    {
      "start": 76.29,
      "end": 77.79,
      "text": "最後比較一下"
    },
    {
      "start": 77.79,
      "end": 79.89,
      "text": "升級前後的差異吧"
    },
    {
      "start": 79.89,
      "end": 80.89,
      "text": "接著"
    },
    {
      "start": 80.89,
      "end": 83.49,
      "text": "把重點元素的積木拼起來"
    },
    {
      "start": 83.49,
      "end": 86.69,
      "text": "準備你最閃亮的最終發表"
    },
    {
      "start": 86.69,
      "end": 89.13,
      "text": "跟著老師計時練習"
    },
    {
      "start": 89.13,
      "end": 93.21,
      "text": "一次抓一個內容或表達的小缺點來修正就好"
    },
    {
      "start": 93.21,
      "end": 95.01,
      "text": "影片先暫停"
    },
    {
      "start": 95.01,
      "end": 96.21,
      "text": "跟老師聊聊"
    },
    {
      "start": 96.21,
      "end": 97.69,
      "text": "如果重來一次"
    },
    {
      "start": 97.69,
      "end": 99.33,
      "text": "你會改變什麼呢"
    }
  ]
}
