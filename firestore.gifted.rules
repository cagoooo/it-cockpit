rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing Teacher App rules. Keep these unchanged when updating gifted sync.
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update, delete: if request.auth != null;
    }

    match /leaveRecords/{recordId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.teacherId is string
        && request.resource.data.leaveType is string;
      allow update, delete: if request.auth != null;
    }

    match /substitutions/{subId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.substituteTeacherId is string
        && request.resource.data.originalTeacherId is string;
      allow update, delete: if request.auth != null;
    }

    // Gifted lab teacher notes. The 64-character document id is a SHA-256
    // digest of a locally generated 128-bit sync key. Listing is never allowed.
    match /giftedTeacherSync/{syncId} {
      function signedInWithValidId() {
        return request.auth != null
          && syncId.matches('^[a-f0-9]{64}$');
      }
      function validPayload() {
        return request.resource.data.keys().hasOnly([
          'source', 'schemaVersion', 'snapshot', 'deviceLabel', 'clientUpdatedAt', 'updatedAt'
        ])
          && request.resource.data.source == 'gifted-ai-lab'
          && request.resource.data.schemaVersion == 1
          && request.resource.data.snapshot is map
          && request.resource.data.deviceLabel is string
          && request.resource.data.deviceLabel.size() <= 40
          && request.resource.data.clientUpdatedAt is int
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if signedInWithValidId();
      allow create, update: if signedInWithValidId() && validPayload();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
